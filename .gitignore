# ---- private / personal material: never commit ----
*.pdf
*.eml

# ---- data: only documentation and the small manifest are versioned ----
# REFIT archives (1.2 GB), extracted CSVs (~7 GB) and the Parquet cache are rebuilt by
# scripts/prepare_data.py; see data/README.md.
data/*
!data/README.md
!data/manifest.json
!data/CLEAN_READ_ME_081116.txt

# ---- research: notes are versioned; third-party papers are fetched locally, not redistributed ----
research/papers/
research/dataset/

*.7z
*.csv
!artifacts/**/*.csv
*.parquet

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# ---- env / secrets ----
.env
.venv/

# ---- model checkpoints: rebuilt by the notebooks; only the exported ONNX model is versioned ----
artifacts/models/*.pt
artifacts/models/*.ckpt
artifacts/models/*.txt

# ---- os / editor ----
.DS_Store
Thumbs.db
.vscode/
